{
  "name": "@pillar-ai/sdk",
  "version": "0.1.27",
  "description": "Product copilot SDK for SaaS and web apps — AI assistant that executes tasks, not just answers questions",
  "type": "module",
  "main": "./dist/pillar.esm.js",
  "module": "./dist/pillar.esm.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pillar-sync": "./dist/cli/sync.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pillar.esm.js",
      "default": "./dist/pillar.esm.js"
    }
  },
  "files": [
    "dist/pillar.esm.js",
    "dist/**/*.d.ts",
    "dist/cli/sync.js",
    "src/actions/types.ts",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && npm run build:cli && npm run build:types",
    "build:cli": "npx esbuild src/cli/sync.ts --bundle --platform=node --target=node18 --outfile=dist/cli/sync.js --format=esm --external:typescript --banner:js='#!/usr/bin/env node'",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "copilot",
    "assistant",
    "ai",
    "sdk",
    "saas",
    "embedded",
    "agent",
    "support",
    "chat"
  ],
  "author": "Pillar Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pillarhq/sdk",
    "directory": "packages/sdk"
  },
  "homepage": "https://trypillar.com",
  "bugs": {
    "url": "https://github.com/pillarhq/sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^2.5.1",
    "@opentelemetry/core": "^2.5.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/sdk-trace-web": "^2.5.1",
    "@preact/signals": "^1.3.1",
    "marked": "^17.0.1",
    "preact": "^10.25.4",
    "preact-iso": "^2.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "sideEffects": false
}
